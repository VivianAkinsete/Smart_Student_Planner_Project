# views/tasks_screen.kv
# Tasks list screen — search, filters, full list, FAB, nav bar.

<TasksScreen>:
    canvas.before:
        Color:
            rgba: app.theme_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(16), dp(8), dp(16), dp(8)]
            spacing: dp(12)
            canvas.before:
                Color:
                    rgba: app.theme_surface
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: app.theme_border
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: dp(0.8)

            Label:
                text: "Tasks"
                font_size: dp(18)
                bold: True
                color: app.theme_header_text
                halign: "left"
                text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(52)
            padding: [dp(16), dp(6), dp(16), dp(6)]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: app.theme_surface
                Rectangle:
                    pos: self.pos
                    size: self.size

            TextInput:
                id: search_input
                hint_text: "Search tasks..."
                hint_text_color: app.theme_text_muted
                font_size: dp(14)
                size_hint_y: None
                height: dp(40)
                padding: [dp(12), dp(10), dp(12), dp(10)]
                background_color: app.theme_input_bg
                foreground_color: app.theme_text
                cursor_color: app.theme_accent
                multiline: False
                on_text: root.on_search(self.text)
                canvas.before:
                    Color:
                        rgba: app.theme_border
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(20)]
                        width: dp(0.8)

        ScrollView:
            size_hint_y: None
            height: dp(48)
            do_scroll_y: False

            BoxLayout:
                id: filter_bar
                orientation: "horizontal"
                size_hint_x: None
                width: self.minimum_width
                padding: [dp(16), dp(6), dp(16), dp(6)]
                spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(36)
            padding: [dp(16), dp(4), dp(16), dp(4)]

            Label:
                text: "All Tasks"
                font_size: dp(16)
                bold: True
                color: app.theme_header_text
                halign: "left"
                text_size: self.width, None

            Label:
                id: task_count_label
                text: ""
                font_size: dp(12)
                color: app.theme_text_muted
                halign: "right"
                text_size: self.width, None

        ScrollView:
            BoxLayout:
                id: task_list
                orientation: "vertical"
                padding: [dp(16), dp(4), dp(16), dp(80)]
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            canvas.before:
                Color:
                    rgba: app.theme_surface
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: app.theme_border
                Line:
                    points: [self.x, self.top, self.right, self.top]
                    width: dp(0.8)

            Button:
                text: "[font=mdi]\U000F056E[/font]\nDashboard"
                markup: True
                font_size: dp(10)
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: app.theme_nav_inactive_text
                on_press: root.go_to_dashboard()

            Button:
                text: "[font=mdi]\U000F0279[/font]\nTasks"
                markup: True
                font_size: dp(10)
                background_normal: ""
                background_color: app.theme_nav_active_bg
                color: app.theme_nav_active_text
                on_press: pass

            Button:
                text: "[font=mdi]\U000F0009[/font]\nProfile"
                markup: True
                font_size: dp(10)
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: app.theme_nav_inactive_text
                on_press: root.go_to_profile()

    AnchorLayout:
        anchor_x: "right"
        anchor_y: "bottom"
        padding: [0, 0, dp(20), dp(70)]

        Button:
            size_hint: None, None
            size: dp(56), dp(56)
            text: "+"
            font_size: dp(28)
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: app.theme_header_text
            on_press: root.go_to_add_task()
            canvas.before:
                Color:
                    rgba: app.theme_accent
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]
