# views/signup_screen.kv
# Sign up screen — consistent with login styling.

<SignupScreen>:
    canvas.before:
        Color:
            rgba: app.theme_bg
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: "vertical"
            padding: dp(24)
            spacing: dp(16)
            size_hint_y: None
            height: max(self.minimum_height, root.height)

            Widget:
                size_hint_y: None
                height: dp(40)

            BoxLayout:
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                height: self.minimum_height
                padding: dp(32)
                spacing: dp(16)
                canvas.before:
                    Color:
                        rgba: app.theme_surface
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16)]
                    Color:
                        rgba: app.theme_border
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(16)]
                        width: dp(0.8)

                Label:
                    text: "Create Account"
                    font_size: dp(24)
                    bold: True
                    color: app.theme_header_text
                    halign: "center"
                    size_hint_y: None
                    height: dp(30)

                Label:
                    text: "Set up your planner profile"
                    font_size: dp(13)
                    color: app.theme_text_muted
                    halign: "center"
                    size_hint_y: None
                    height: dp(18)

                BoxLayout:
                    id: error_box
                    size_hint_y: None
                    height: dp(0)
                    opacity: 0
                    padding: dp(12)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 1, 0.855, 0.839, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]

                    Label:
                        id: error_label
                        text: ""
                        font_size: dp(13)
                        color: 0.576, 0, 0.039, 1
                        text_size: self.width, None
                        halign: "left"
                        valign: "middle"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)

                    Label:
                        text: "USERNAME"
                        font_size: dp(11)
                        bold: True
                        color: app.theme_text_muted
                        halign: "left"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(16)

                    TextInput:
                        id: username_input
                        hint_text: "Choose a username"
                        hint_text_color: app.theme_text_muted
                        font_size: dp(15)
                        size_hint_y: None
                        height: dp(48)
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        background_color: app.theme_input_bg
                        foreground_color: app.theme_text
                        cursor_color: app.theme_accent
                        multiline: False
                        on_text_validate: root.on_signup()
                        canvas.before:
                            Color:
                                rgba: app.theme_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
                                width: dp(1)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)

                    Label:
                        text: "DISPLAY NAME"
                        font_size: dp(11)
                        bold: True
                        color: app.theme_text_muted
                        halign: "left"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(16)

                    TextInput:
                        id: display_name_input
                        hint_text: "How should we greet you?"
                        hint_text_color: app.theme_text_muted
                        font_size: dp(15)
                        size_hint_y: None
                        height: dp(48)
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        background_color: app.theme_input_bg
                        foreground_color: app.theme_text
                        cursor_color: app.theme_accent
                        multiline: False
                        on_text_validate: root.on_signup()
                        canvas.before:
                            Color:
                                rgba: app.theme_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
                                width: dp(1)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)

                    Label:
                        text: "PASSWORD"
                        font_size: dp(11)
                        bold: True
                        color: app.theme_text_muted
                        halign: "left"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(16)

                    TextInput:
                        id: password_input
                        hint_text: "Create a password"
                        hint_text_color: app.theme_text_muted
                        font_size: dp(15)
                        password: True
                        size_hint_y: None
                        height: dp(48)
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        background_color: app.theme_input_bg
                        foreground_color: app.theme_text
                        cursor_color: app.theme_accent
                        multiline: False
                        on_text_validate: root.on_signup()
                        canvas.before:
                            Color:
                                rgba: app.theme_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
                                width: dp(1)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)

                    Label:
                        text: "CONFIRM PASSWORD"
                        font_size: dp(11)
                        bold: True
                        color: app.theme_text_muted
                        halign: "left"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(16)

                    TextInput:
                        id: confirm_input
                        hint_text: "Re-enter your password"
                        hint_text_color: app.theme_text_muted
                        font_size: dp(15)
                        password: True
                        size_hint_y: None
                        height: dp(48)
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        background_color: app.theme_input_bg
                        foreground_color: app.theme_text
                        cursor_color: app.theme_accent
                        multiline: False
                        on_text_validate: root.on_signup()
                        canvas.before:
                            Color:
                                rgba: app.theme_border
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
                                width: dp(1)

                Button:
                    text: "Sign Up →"
                    font_size: dp(16)
                    bold: True
                    size_hint_y: None
                    height: dp(52)
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    on_press: root.on_signup()
                    canvas.before:
                        Color:
                            rgba: app.theme_accent
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]
                    color: 1, 1, 1, 1

                Button:
                    text: "Back to login"
                    font_size: dp(13)
                    size_hint_y: None
                    height: dp(40)
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: app.theme_text_muted
                    on_press: root.go_to_login()

            Widget:
                size_hint_y: None
                height: dp(40)
